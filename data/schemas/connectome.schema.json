{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bythewayz66-glitch/mem20-brainz/data/schemas/connectome.schema.json",
  "title": "SparseConnectome fixture",
  "description": "Coordinate-list connectome fixture. Small test data only; real connectomes live in external storage.",
  "type": "object",
  "required": ["n_neurons", "pre", "post"],
  "properties": {
    "n_neurons": { "type": "integer", "minimum": 0 },
    "pre": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
    "post": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
    "weight": { "type": "array", "items": { "type": "number" } },
    "delay_ms": { "type": "array", "items": { "type": "number", "minimum": 0 } }
  },
  "additionalProperties": false
}
