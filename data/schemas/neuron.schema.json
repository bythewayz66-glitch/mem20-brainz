{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bythewayz66-glitch/mem20-brainz/data/schemas/neuron.schema.json",
  "title": "Neuron record",
  "description": "Minimal per-neuron record. Model parameters are placeholders until a validated model hierarchy exists.",
  "type": "object",
  "required": ["id", "model"],
  "properties": {
    "id": { "type": "integer", "minimum": 0 },
    "model": { "type": "string", "enum": ["lif"] },
    "region": { "type": "string" },
    "cell_type": { "type": "string" },
    "v_rest_mv": { "type": "number" },
    "v_threshold_mv": { "type": "number" },
    "v_reset_mv": { "type": "number" },
    "tau_m_ms": { "type": "number", "exclusiveMinimum": 0 },
    "r_m_mohm": { "type": "number", "exclusiveMinimum": 0 }
  },
  "additionalProperties": false
}
